<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="rootPane" prefHeight="909.0" prefWidth="1292.0" spacing="15.0" style="-fx-background-color: #1a1a1a;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carapp.car_rental_and_sales_system.controller.ArchivedCustomerController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <!-- العنوان والبحث -->
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <VBox>
               <children>
                  <Label text="Archived Customers" textFill="#e67e22">
                     <font>
                        <Font name="System Bold" size="28.0" />
                     </font>
                  </Label>
                  <Label text="Manage and reactivate deactivated client accounts" textFill="#e4b300">
                     <font>
                        <Font size="14.0" />
                     </font></Label>
               </children>
            </VBox>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <!-- ✅ حقل البحث المضاف -->
            <TextField fx:id="txtSearch" prefHeight="35.0" prefWidth="500.0" promptText="🔍 Search Archive by Name, National ID or Phone..." style="-fx-background-radius: 15; -fx-font-size: 14px;" />
         </children>
      </HBox>
      
      <!-- الجدول -->
      <TableView fx:id="tableArchived" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colId" prefWidth="100.0" text="ID" />
          <TableColumn fx:id="colName" prefWidth="350.0" text="Customer Name" />
          <!-- ✅ إضافة عمود الرقم القومي -->
          <TableColumn fx:id="colNationalId" prefWidth="200.0" text="National ID" />
          <TableColumn fx:id="colPhone" prefWidth="250.0" text="Phone Number" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      
      <!-- شريط الأزرار السفلي (الترتيب الجديد) -->
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <!-- 1. عرض المعاملات (أزرق) -->
            <Button fx:id="btnViewTransactions" disable="true" mnemonicParsing="false" onAction="#btnViewTransactionsAction" prefHeight="35.0" prefWidth="200.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="📜 View Transactions" />
            
            <!-- ✅ الزرار الجديد بتاع الإكسيل -->
            <Button mnemonicParsing="false" onAction="#btnExportToExcelAction" prefHeight="35.0" prefWidth="160.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="📊 Export Excel" />
            
            <!-- 2. التنشيط (أخضر - يقابل Archive) -->
            <Button fx:id="btnReactivate" disable="true" mnemonicParsing="false" onAction="#btnReactivateAction" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="✅ Reactivate" />
            
            <!-- 3. تنشيط الكل (برتقالي غامق - يقابل Archive All) -->
            <Button fx:id="btnReactivateAll" mnemonicParsing="false" onAction="#btnReactivateAllAction" prefHeight="35.0" prefWidth="160.0" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="♻️ Reactivate All" />
            
            <!-- فاصل مرن -->
            <Region HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </children>
</VBox>