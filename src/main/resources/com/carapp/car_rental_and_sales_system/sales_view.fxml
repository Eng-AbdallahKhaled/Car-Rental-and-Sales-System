<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="rootPane" prefHeight="891.0" prefWidth="1312.0" spacing="15.0" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carapp.car_rental_and_sales_system.controller.SaleController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <VBox>
               <children>
                  <Label text="Sales Management" textFill="#fcd513">
                     <font><Font name="System Bold" size="28.0" /></font>
                  </Label>
                  <Label text="Process sales and manage invoices" textFill="#e4b300">
                     <font>
                        <Font size="14.0" />
                     </font></Label>
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtSearchTable" prefHeight="35.0" prefWidth="500.0" promptText="🔍 Search Sales..." style="-fx-background-radius: 15; -fx-font-size: 14px;" />
         </children>
      </HBox>
      
      <!-- منطقة الإدخال -->
      <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #1a1a1a; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.5), 10, 0, 0, 5);">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <VBox spacing="10.0">
               <children>
                  <Label text="New Sale Transaction" textFill="#ffd400"><font><Font name="System Bold" size="14.0" /></font></Label>
                  <HBox alignment="CENTER_LEFT" spacing="25.0">
                     <children>
                        <VBox spacing="5.0">
                           <Label text="Car" textFill="#ffcc00" />
                           <HBox spacing="20.0">
                               <TextField fx:id="txtSearchCar" prefHeight="35.0" prefWidth="200.0" promptText="Search Car..." />
                               <ComboBox fx:id="comboCars" prefHeight="35.0" prefWidth="250.0" promptText="Select Car" />
                           </HBox>
                        </VBox>
                        <VBox spacing="5.0">
                           <Label text="Customer" textFill="#ffcc00" />
                           <HBox spacing="20.0">
                               <TextField fx:id="txtSearchCustomer" prefHeight="35.0" prefWidth="200.0" promptText="Search Customer..." />
                               <ComboBox fx:id="comboCustomers" prefHeight="35.0" prefWidth="250.0" promptText="Select Buyer" />
                           </HBox>
                        </VBox>
                     </children>
                  </HBox>
                  
                  <HBox alignment="CENTER_LEFT" spacing="20.0">
                     <children>
                        <VBox spacing="5.0">
                           <Label text="Sale Price" textFill="#ffcc00" />
                           <HBox alignment="CENTER_LEFT" spacing="20.0">
                              <TextField fx:id="txtFinalPrice" prefHeight="35.0" prefWidth="150.0" promptText="Amount ($)" />
                              <VBox>
                                  <Label text="Date:" textFill="#ffcc00"><font><Font size="10.0" /></font></Label>
                                  <Label fx:id="lblDate" text="2024-01-01" textFill="#73a4a8"><font><Font name="System Bold" size="12.0" /></font></Label>
                              </VBox>
                           </HBox>
                        </VBox>
                        <Region prefHeight="54.0" prefWidth="300.0" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnShowData" onAction="#btnShowDataAction" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #f1c40f; -fx-text-fill: Black;" text="📄 Info" />
                        <Button fx:id="btnShowImages" onAction="#btnShowImagesAction" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #8e44ad; -fx-text-fill: white;" text="📷 Gallery" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <Region prefHeight="74.0" prefWidth="32.0" HBox.hgrow="ALWAYS" />
            
            <!-- فاصل -->
            <VBox alignment="CENTER">
                <Separator orientation="VERTICAL" prefHeight="100.0" />
            </VBox>
            
            <!-- زر الإتمام -->
            <VBox alignment="CENTER">
                <Button onAction="#btnSellCar" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14px;" text="💰 Confirm Sale" />
            </VBox>
            
            <VBox alignment="CENTER">
                <Separator orientation="VERTICAL" prefHeight="100.0" />
            </VBox>
            
            <!-- صورة المعاينة -->
            <VBox alignment="CENTER" style="-fx-border-color: #333; -fx-border-radius: 10; -fx-border-style: dashed;">
               <padding><Insets bottom="5.0" left="5.0" right="5.0" top="5.0" /></padding>
               <children>
                  <ImageView fx:id="imgCarPreview" fitHeight="150.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true" />
               </children>
            </VBox>
         </children>
      </HBox>

      <TableView fx:id="tableSales" prefHeight="35.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDate" prefWidth="120.0" text="Sale Date" />
            <TableColumn fx:id="colId" prefWidth="100.0" text="ID" />
            <TableColumn fx:id="colCar" prefWidth="250.0" text="Car Info" />
            <TableColumn fx:id="colCustomer" prefWidth="150.0" text="Customer" />
            <TableColumn fx:id="colPrice" prefWidth="150.0" text="Price" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      
      <!-- الشريط السفلي -->
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <Button fx:id="btnOpenInvoice" disable="true" mnemonicParsing="false" onAction="#btnOpenInvoiceAction" prefHeight="35.0" prefWidth="200.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="📜 View Contract" />
            <Button fx:id="btnTableShowData" mnemonicParsing="false" onAction="#btnTableShowDataAction" prefHeight="35.0" prefWidth="130.0" style="-fx-background-color: #f1c40f; -fx-text-fill: black;" text="ℹ️ Info" />
            <Button fx:id="btnTableShowImages" mnemonicParsing="false" onAction="#btnTableShowImagesAction" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #8e44ad; -fx-text-fill: white;" text="📷 Gallery" />
            <Region HBox.hgrow="ALWAYS" />
            <!-- ✅ إضافة زر الإكسيل هنا -->
            <Button fx:id="btnExportExcel" mnemonicParsing="false" onAction="#btnExportToExcelAction" prefHeight="35.0" prefWidth="160.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="📊 Export to Excel" />
            <VBox alignment="CENTER">
               <Separator orientation="VERTICAL" prefHeight="35.0" />
            </VBox>
            <Button fx:id="btnReturnCar" disable="true" mnemonicParsing="false" onAction="#btnReturnCarAction" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="↩️ Refund Sale" />
         </children>
      </HBox>
   </children>
</VBox>