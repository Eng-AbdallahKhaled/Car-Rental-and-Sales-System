<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainBorderPane" prefHeight="796.0" prefWidth="1200.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carapp.car_rental_and_sales_system.controller.MainController">
   
   <!-- ================= القائمة الجانبية (Sidebar) ================= -->
   <left>
      <VBox alignment="TOP_CENTER" prefHeight="796.0" prefWidth="300.0" spacing="40.0" style="-fx-background-color: #1E293B;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Luxury Cars" textFill="#c9a227">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" top="20.0" />
               </VBox.margin>
            </Label>
            
            <!-- زرار الداشبورد الجديد عشان نرجع للإحصائيات -->
            <Button fx:id="btnHome" mnemonicParsing="false" onAction="#btnShowHome" prefHeight="50.0" prefWidth="230.0" style="-fx-background-color: #1C1F26; -fx-background-radius: 14; -fx-text-fill: #D4AF37; -fx-border-color: #fcd513; -fx-border-width: 0 0 0 5; -fx-border-radius: 14; -fx-cursor: hand;" text="🏠 Dashboard" styleClass="active-menu-btn">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            
            <!-- أزرار التنقل الرئيسية -->
            <Button fx:id="btnCars" mnemonicParsing="false" onAction="#btnShowCars" prefHeight="50.0" prefWidth="230.0" style="-fx-background-color: #1C1F26; -fx-background-radius: 14; -fx-text-fill: #D4AF37; -fx-border-color: #8C7A2E; -fx-border-radius: 14; -fx-cursor: hand;" text="🚗 Cars">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            
            <Button fx:id="btnCustomers" mnemonicParsing="false" onAction="#btnShowCustomers" prefHeight="50.0" prefWidth="230.0" style="-fx-background-color: #1C1F26; -fx-background-radius: 14; -fx-text-fill: #D4AF37; -fx-border-color: #8C7A2E; -fx-border-radius: 14; -fx-cursor: hand;" text="👥 Customers">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>

            <Button fx:id="btnArchives" mnemonicParsing="false" onAction="#btnShowArchives" prefHeight="50.0" prefWidth="230.0" style="-fx-background-color: #1C1F26; -fx-background-radius: 14; -fx-text-fill: #D4AF37; -fx-border-color: #8C7A2E; -fx-border-radius: 14; -fx-cursor: hand;" text="📁 Archived Customers">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            
            <Button fx:id="btnRentals" mnemonicParsing="false" onAction="#btnShowRentals" prefHeight="50.0" prefWidth="230.0" style="-fx-background-color: #1C1F26; -fx-background-radius: 14; -fx-text-fill: #D4AF37; -fx-border-color: #8C7A2E; -fx-border-radius: 14; -fx-cursor: hand;" text="📝 Rentals">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            
            <Button fx:id="btnSales" mnemonicParsing="false" onAction="#btnShowSales" prefHeight="50.0" prefWidth="230.0" style="-fx-background-color: #1C1F26; -fx-background-radius: 14; -fx-text-fill: #D4AF37; -fx-border-color: #8C7A2E; -fx-border-radius: 14; -fx-cursor: hand;" text="💰 Sales">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            
            <!-- قسم أزرار التحكم في الحساب -->
            <VBox alignment="BOTTOM_CENTER" spacing="30.0" VBox.vgrow="ALWAYS">
               <children>
                  <Button fx:id="btnChangePassword" mnemonicParsing="false" onAction="#btnChangePasswordAction" prefHeight="50.0" prefWidth="230.0" style="-fx-background-color: #1C1F26; -fx-background-radius: 14; -fx-text-fill: #D4AF37; -fx-border-color: #8C7A2E; -fx-border-radius: 14; -fx-cursor: hand;" text="🔒 Change Password">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Button>
                  
                  <Button mnemonicParsing="false" onAction="#btnLogoutAction" prefHeight="50.0" prefWidth="230.0" style="-fx-background-color: #c0392b; -fx-background-radius: 14; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-color: #c0392b; -fx-border-radius: 14; -fx-cursor: hand;" text="🚪 Logout">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets bottom="20.0" />
               </VBox.margin>
            </VBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </left>
   
   <!-- ================= المنطقة المركزية (الداشبورد والإحصائيات) ================= -->
   <center>
      <!-- دي الشاشة اللي هتبان أول ما نفتح، ولما نغيرها هنرجع نحطها تاني هنا -->
      <VBox prefHeight="800.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #121212;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>

         <Label text="System Dashboard" textFill="#fcd513">
            <font>
               <Font name="System Bold" size="28.0" />
            </font>
         </Label>

         <!-- الكروت الإحصائية (Cards) -->
         <HBox spacing="20.0">
            <VBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: #1a1a1a; -fx-background-radius: 10; -fx-border-color: #333; -fx-border-radius: 10;" HBox.hgrow="ALWAYS">
               <Label text="Total Inventory" textFill="#aaaaaa">
                  <font><Font size="14.0" /></font>
               </Label>
               <Label fx:id="lblTotalCars" text="0" textFill="#fcd513">
                  <font><Font name="System Bold" size="36.0" /></font>
               </Label>
            </VBox>

            <VBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: #1a1a1a; -fx-background-radius: 10; -fx-border-color: #333; -fx-border-radius: 10;" HBox.hgrow="ALWAYS">
               <Label text="Currently Rented" textFill="#aaaaaa">
                  <font><Font size="14.0" /></font>
               </Label>
               <Label fx:id="lblRentedCars" text="0" textFill="#3498db">
                  <font><Font name="System Bold" size="36.0" /></font>
               </Label>
            </VBox>

            <VBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: #1a1a1a; -fx-background-radius: 10; -fx-border-color: #333; -fx-border-radius: 10;" HBox.hgrow="ALWAYS">
               <Label text="Sold Cars" textFill="#aaaaaa">
                  <font><Font size="14.0" /></font>
               </Label>
               <Label fx:id="lblSoldCars" text="0" textFill="#e74c3c">
                  <font><Font name="System Bold" size="36.0" /></font>
               </Label>
            </VBox>

            <VBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: #1a1a1a; -fx-background-radius: 10; -fx-border-color: #333; -fx-border-radius: 10;" HBox.hgrow="ALWAYS">
               <Label text="Total Revenue" textFill="#aaaaaa">
                  <font><Font size="14.0" /></font>
               </Label>
               <Label fx:id="lblTotalRevenue" text="\$0.0" textFill="#2ecc71">
                  <font><Font name="System Bold" size="36.0" /></font>
               </Label>
            </VBox>
         </HBox>

         <!-- الرسومات البيانية (Charts) -->
         <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <VBox style="-fx-background-color: #1a1a1a; -fx-background-radius: 10; -fx-padding: 10;" HBox.hgrow="ALWAYS">
               <Label text="Cars Status Overview" textFill="WHITE">
                  <font><Font name="System Bold" size="16.0" /></font>
               </Label>
               <PieChart fx:id="pieChartCars" VBox.vgrow="ALWAYS" />
            </VBox>

            <VBox style="-fx-background-color: #1a1a1a; -fx-background-radius: 10; -fx-padding: 10;" HBox.hgrow="ALWAYS">
               <Label text="Revenue Analytics" textFill="WHITE">
                  <font><Font name="System Bold" size="16.0" /></font>
               </Label>
               <BarChart fx:id="barChartRevenue" VBox.vgrow="ALWAYS">
                  <xAxis>
                     <CategoryAxis side="BOTTOM" tickLabelFill="WHITE" />
                  </xAxis>
                  <yAxis>
                     <NumberAxis side="LEFT" tickLabelFill="WHITE" />
                  </yAxis>
               </BarChart>
            </VBox>
         </HBox>

         <!-- نظام التنبيهات الذكي (Smart Alerts) -->
         <VBox prefHeight="150.0" style="-fx-background-color: #1a1a1a; -fx-background-radius: 10; -fx-padding: 15;">
            <Label text="🔔 Smart Alerts &amp; Notifications" textFill="#fcd513">
               <font><Font name="System Bold" size="18.0" /></font>
               <VBox.margin><Insets bottom="10.0" /></VBox.margin>
            </Label>
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <!-- الـ VBox ده اللي هنرمي فيه رسايل الإنذارات من الكود -->
                  <VBox fx:id="vboxAlerts" spacing="10.0" />
               </content>
            </ScrollPane>
         </VBox>
      </VBox>
   </center>
</BorderPane>